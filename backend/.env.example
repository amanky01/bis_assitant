# ── MongoDB ───────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=bis_assistant

# ── LLM inference (embeddings always use Gemini below) ──
LLM_PROVIDER=gemini                    # gemini | groq
GROQ_API_KEY=                          # required when LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# ── Gemini (required for embeddings; also chat when LLM_PROVIDER=gemini) ──
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash          # gemini-2.0-flash | gemini-1.5-flash-001 | gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/embedding-001
EMBEDDING_DIMENSIONS=768

# ── Web RAG ───────────────────────────────────────────
TAVILY_API_KEY=tvly-...
# Comma-separated — DO NOT add domains outside this list
ALLOWED_DOMAINS=bis.gov.in,bis.org.in,manakonline.in,crsbis.in,huid.manakonline.in,beeindia.gov.in

# ── Auth / JWT ────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080          # 7 days

# ── Session ───────────────────────────────────────────
SESSION_TTL_HOURS=2               # anonymous session lifetime
SESSION_WINDOW_SIZE=12            # messages kept in context window
SESSION_ASSISTANT_SAVE_MAX_CHARS=4000   # truncate assistant message when saving (0 = no limit)
SESSION_CONTEXT_ASSISTANT_MAX_CHARS=700 # truncate each assistant reply in LLM context

# ── Agent ─────────────────────────────────────────────
AGENT_MAX_ITERATIONS=8            # hard cap on ReAct tool calls per message
AGENT_TEMPERATURE=0.2
PRE_INJECT_RAG=true               # run vector search before first LLM call and inject to reduce round-trips
PRE_INJECT_RAG_TOP_K=5            # number of chunks to pre-inject (1–15)

# ── App ───────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# Extra comma-separated origins (merged with built-in localhost + mindsqubit + Vercel URLs in code).
CORS_ORIGINS=http://localhost:3000
